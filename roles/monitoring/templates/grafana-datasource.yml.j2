---
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus

    # Grafana обращается к Prometheus из Docker-сети.
    access: proxy
    url: http://prometheus:9090

    # Делаем Prometheus источником данных по умолчанию.
    isDefault: true

    # Разрешаем редактировать источник через UI.
    editable: true

    jsonData:
      timeInterval: "{{ monitoring_prometheus_scrape_interval }}"