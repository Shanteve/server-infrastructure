concurrent = {{ gitlab_runner_concurrent }}
check_interval = {{ gitlab_runner_check_interval }}

log_level = "info"
log_format = "json"

[[runners]]
  name = {{ gitlab_runner_name | to_json }}
  url = {{ gitlab_runner_url | to_json }}
  token = {{ gitlab_runner_token | to_json }}

  executor = "docker"
  limit = {{ gitlab_runner_limit }}
  request_concurrency = 2

  # Docker executor
  [runners.docker]
    host = {{ gitlab_runner_docker_host | to_json }}

    image = {{ gitlab_runner_docker_image | to_json }}
    pull_policy = ["always", "if-not-present", "never"]

    privileged = false
    tls_verify = false

    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false

    # Resource limits
    cpus = {{ gitlab_runner_docker_cpus | to_json }}
    memory = {{ gitlab_runner_docker_memory | to_json }}

    services_privileged = true
    # Только конкретная версия rootless DinD
    allowed_privileged_services = [
      "docker:29.10-dind-rootless",
      "docker.io/library/docker:29.10-dind-rootless"
    ]

    # Volumes
    volumes = {{ gitlab_runner_docker_volumes | to_json }}
