services:
  # -----------------------------------------------------
  # Prometheus
  # -----------------------------------------------------

  prometheus:
    image: "{{ monitoring_prometheus_image }}"

    restart: unless-stopped

    # Контейнер запускается без root-привилегий.
    user: "65534:65534"

    # Файловая система контейнера доступна только для чтения.
    read_only: true

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    # Порт доступен только с самого сервера.
    ports:
      - "{{ monitoring_bind_address }}:{{ monitoring_prometheus_host_port }}:9090"

    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ monitoring_prometheus_retention_time }}"
      - "--storage.tsdb.retention.size={{ monitoring_prometheus_retention_size }}"
      - "--web.listen-address=0.0.0.0:9090"
      - "--web.external-url=http://localhost:{{ monitoring_prometheus_host_port }}/"

    volumes:
      # Конфигурация доступна только для чтения.
      - "{{ monitoring_prometheus_config_file }}:/etc/prometheus/prometheus.yml:ro"

      # Правила оповещений.
      - "{{ monitoring_prometheus_rules_file }}:/etc/prometheus/alert-rules.yml:ro"

      # Постоянное хранилище метрик.
      - prometheus_data:/prometheus

    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=32m

    mem_limit: "{{ monitoring_prometheus_memory }}"
    cpus: {{ monitoring_prometheus_cpus }}

  # -----------------------------------------------------
  # Grafana
  # -----------------------------------------------------

  grafana:
    image: "{{ monitoring_grafana_image }}"

    restart: unless-stopped

    # Официальный UID Grafana и основная группа root.
    user: "472:0"

    read_only: true

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    ports:
      - "{{ monitoring_bind_address }}:{{ monitoring_grafana_host_port }}:3000"

    environment:
      GF_SERVER_HTTP_ADDR: "0.0.0.0"
      GF_SERVER_HTTP_PORT: "3000"

      GF_SERVER_DOMAIN: "localhost"
      GF_SERVER_ROOT_URL: "http://localhost:{{ monitoring_grafana_host_port }}/"

      # Пароль читается из Docker Secret.
      # Он не передаётся непосредственно через environment.
      GF_SECURITY_ADMIN_USER: "{{ monitoring_grafana_admin_user }}"
      GF_SECURITY_ADMIN_PASSWORD__FILE: "/run/secrets/grafana_admin_password"

      # Отключаем анонимный доступ и самостоятельную регистрацию.
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_USERS_ALLOW_ORG_CREATE: "false"

      # Дополнительные настройки безопасности.
      GF_SECURITY_COOKIE_SAMESITE: "strict"
      GF_SECURITY_DISABLE_GRAVATAR: "true"

      # Отключаем необязательную аналитику и обновления через UI.
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"

      # Логи отправляются в stdout/stderr контейнера.
      GF_LOG_MODE: "console"
      GF_LOG_LEVEL: "info"

      # Доступ осуществляется через SSH-туннель по HTTP.
      GF_SECURITY_COOKIE_SECURE: "false"

    secrets:
      - grafana_admin_password

    volumes:
      # База Grafana, настройки и установленные плагины.
      - grafana_data:/var/lib/grafana

      # Автоматическая настройка Prometheus datasource.
      - "{{ monitoring_grafana_provisioning_dir }}:/etc/grafana/provisioning/datasources:ro"

    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=32m

    mem_limit: "{{ monitoring_grafana_memory }}"
    cpus: {{ monitoring_grafana_cpus }}


  # -----------------------------------------------------
  # Node Exporter
  # -----------------------------------------------------

  node-exporter:
    image: "{{ monitoring_node_exporter_image }}"

    restart: unless-stopped

    user: "65534:65534"

    read_only: true

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"

      # Исключаем виртуальные и Docker filesystem mounts.
      - '--collector.filesystem.mount-points-exclude=^/(dev|proc|sys|var/lib/docker/.+|var/lib/containerd/.+)($$|/)'

    volumes:
      # Информация о процессах и ядре.
      - /proc:/host/proc:ro

      # Информация о системных устройствах и cgroups.
      - /sys:/host/sys:ro

      # Файловая система хоста.
      - /:/rootfs:ro,rslave

    mem_limit: "{{ monitoring_node_exporter_memory }}"
    cpus: {{ monitoring_node_exporter_cpus }}

  # -----------------------------------------------------
  # cAdvisor
  # -----------------------------------------------------

  cadvisor:
    image: "{{ monitoring_cadvisor_image }}"

    restart: unless-stopped
     
    privileged: true

    devices:
      - /dev/kmsg:/dev/kmsg

    volumes:
      # Корневая файловая система хоста.
      - /:/rootfs:ro,rslave

      # Системная информация и cgroups.
      - /sys:/sys:ro

      # Метаданные Docker-контейнеров.
      - /var/lib/docker:/var/lib/docker:ro

      # Docker API для обнаружения контейнеров.
      # Важно: read-only bind mount не ограничивает API-команды.
      - /var/run/docker.sock:/var/run/docker.sock:ro
      
      - /dev/disk:/dev/disk:ro
    
    command:
      - --docker_only=true

    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=16m

    mem_limit: "{{ monitoring_cadvisor_memory }}"
    cpus: {{ monitoring_cadvisor_cpus }}


  # -----------------------------------------------------
  # Blackbox Exporter
  # -----------------------------------------------------

  blackbox-exporter:
    image: "{{ monitoring_blackbox_exporter_image }}"

    restart: unless-stopped

    user: "65534:65534"

    read_only: true

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    command:
      - "--config.file=/etc/blackbox_exporter/blackbox.yml"

    volumes:
      - "{{ monitoring_blackbox_config_file }}:/etc/blackbox_exporter/blackbox.yml:ro"

    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=16m

    mem_limit: "{{ monitoring_blackbox_exporter_memory }}"
    cpus: {{ monitoring_blackbox_exporter_cpus }}


  # -----------------------------------------------------
  # Alertmanager
  # -----------------------------------------------------

  alertmanager:
    image: "{{ monitoring_alertmanager_image }}"

    restart: unless-stopped

    user: "65534:65534"

    read_only: true

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

    ports:
      - "{{ monitoring_bind_address }}:{{ monitoring_alertmanager_host_port }}:9093"

    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"

    volumes:
      - "{{ monitoring_alertmanager_config_file }}:/etc/alertmanager/alertmanager.yml:ro"

      # Хранение данных Alertmanager.
      - alertmanager_data:/alertmanager

    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=16m

    mem_limit: "{{ monitoring_alertmanager_memory }}"
    cpus: {{ monitoring_alertmanager_cpus }}


# -------------------------------------------------------
# Docker volumes
# -------------------------------------------------------

volumes:

  # Долговременное хранение Prometheus TSDB.
  prometheus_data:
    name: "{{ monitoring_project_name }}_prometheus_data"

  # База Grafana.
  grafana_data:
    name: "{{ monitoring_project_name }}_grafana_data"

  # Состояние Alertmanager.
  alertmanager_data:
    name: "{{ monitoring_project_name }}_alertmanager_data"


# -------------------------------------------------------
# Docker Secrets
# -------------------------------------------------------

secrets:
  grafana_admin_password:
    file: "{{ monitoring_grafana_admin_password_file }}"